{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxyConfig": {
    "Routes": {
      "snehajadhav-route": {
        "ClusterId": "snehajadhav-cluster",
        "Match": {
          "Hosts": [ "snehajadhav.com", "www.snehajadhav.com" ],
          "Path": "{**catch-all}"
        }
      },
      "scootr-route": {
        "ClusterId": "scootr-cluster",
        "Match": {
          "Hosts": [ "scootr.in", "www.scootr.in" ],
          "Path": "{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Hosts": [ "admin.scootr.in" ],
          "Path": "{**catch-all}"
        }
      },
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Hosts": [ "api.scootr.in" ],
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "snehajadhav-cluster": {
        "Destinations": {
          "snehajadhav-destination": {
            "Address": "http://localhost:9090/"
          }
        }
      },
      "scootr-cluster": {
        "Destinations": {
          "scootr-destination": {
            "Address": "http://localhost:9081/"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-destination": {
            "Address": "http://localhost:8080/"
          }
        }
      },
      "api-cluster": {
        "Destinations": {
          "api-destination": {
            "Address": "http://localhost:7070/"
          }
        }
      }
    }
  }
}
