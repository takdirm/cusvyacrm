<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	 
	  <AssemblyTitle> Instalx client Library.</AssemblyTitle>
	  <SignAssembly>False</SignAssembly>
	  <IncludeSymbols>true</IncludeSymbols>
	
	 
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>loadbalancer installer</AssemblyName>
    <ApplicationIcon>applogo-main.ico</ApplicationIcon>
 
  </PropertyGroup>

  <ItemGroup>
    <None Remove="App.config" />
    <None Remove="log4net.installer.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Shared\appsettings.json" Link="conf\appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="applogo-main.ico" />
    <Content Include="log4net.installer.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.11.4" />
    <PackageReference Include="IPAddressRange" Version="6.0.0" />
    <PackageReference Include="log4net" Version="2.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.WebSockets" Version="2.1.7" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="6.1.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.61.3" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="WindowsFirewallHelper" Version="2.2.0.86" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Inx.Net.Deploy.Installer\Inx.Net.Deploy.Installer.csproj" />
    <ProjectReference Include="..\Inx.LoadBalancer\Inx.LoadBalancer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Interop.IWshRuntimeLibrary">
      <HintPath>..\..\CommonLibs\Interop.IWshRuntimeLibrary.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Fissionbitz.crt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="conf\" />
  </ItemGroup>

</Project>
